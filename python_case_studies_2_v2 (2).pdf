BT 1 0 0 1 4 97 Tm /F5 8 Tf 10.5 TL (BEGIN) Tj T* (  READ text) Tj T* (  text <- LOWER\(text\) with punctuation removed) Tj T* (  words <- SPLIT\(text\)) Tj T* (  FOR i <- 0 TO len\(words\)-1) Tj T* (     IF words[i] IN uniq THEN increment count, add position i+1) Tj T* (     ELSE append words[i] to uniq with count 1) Tj T* (  FOR each word in uniq: IF count > 1 PRINT word, count, positions) Tj T* (  REPEAT the same for consecutive word pairs) Tj T* (END) Tj T* ET
Q
