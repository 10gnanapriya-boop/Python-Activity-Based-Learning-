BT 1 0 0 1 4 359.5 Tm 10.5 TL /F5 8 Tf 0 0 0 rg (# Case Study 78: Hospital Resource Allocation and Capacity Monitoring) Tj T* (wards = [) Tj T* (    ["ICU", 10, 9, 4, 1],          # name, beds, occupied, staff, free ventilators) Tj T* (    ["General", 40, 30, 6, 0],) Tj T* (    ["Pediatric", 20, 12, 4, 1],) Tj T* (    ["Emergency", 15, 14, 5, 2],) Tj T* (]) Tj T* (patients = [\("Ravi", 1, False\), \("Meena", 3, True\), \("Arjun", 2, False\),) Tj T* (            \("Sita", 3, True\), \("Kiran", 3, True\), \("Asha", 2, False\)]) Tj T* (print\(f"{'Ward':) Tj (<) Tj (10}{'Occ%':) Tj (>) Tj (6}{'Ratio':) Tj (>) Tj (7}  Alerts"\)) Tj T* (for name, beds, occ, staff, vents in wards:) Tj T* (    pct = occ / beds * 100) Tj T* (    ratio = occ / staff) Tj T* (    alerts = []) Tj T* (    if pct ) Tj (>) Tj ( 90: alerts.append\("Bed shortage"\)) Tj T* (    if ratio ) Tj (>) Tj ( 4: alerts.append\("Staff shortage"\)) Tj T* (    if vents == 0: alerts.append\("No ventilator"\)) Tj T* (    print\(f"{name:) Tj (<) Tj (10}{pct:) Tj (>) Tj (6.1f}{ratio:) Tj (>) Tj (7.2f}  {', '.join\(alerts\) if alerts else 'Normal'}"\)) Tj T* (for i in range\(len\(patients\)\):) Tj T* (    for j in range\(len\(patients\) - 1 - i\):) Tj T* (        if patients[j][1] ) Tj (<) Tj ( patients[j + 1][1]:) Tj T* (            patients[j], patients[j + 1] = patients[j + 1], patients[j]) Tj T* (print\("\\nPatient allocation \(by severity\):"\)) Tj T* (for pname, sev, vent in patients:) Tj T* (    placed = False) Tj T* (    for w in wards:) Tj T* (        if w[2] ) Tj (<) Tj ( w[1] and \(not vent or w[4] ) Tj (>) Tj ( 0\):) Tj T* (            w[2] += 1) Tj T* (            if vent:) Tj T* (                w[4] -= 1) Tj T* (            print\(f"  {pname:) Tj (<) Tj (6} severity {sev} -) Tj (>) Tj ( {w[0]}"\)) Tj T* (            placed = True) Tj T* (            break) Tj T* (    if not placed:) Tj T* (        print\(f"  {pname:) Tj (<) Tj (6} severity {sev} -) Tj (>) Tj ( WAITING \(no suitable bed\)"\)) Tj T* ET
Q
Q
