BT 1 0 0 1 4 97 Tm /F5 8 Tf 10.5 TL (BEGIN) Tj T* (  FOR each \(ward, beds, occ, staff, vents_free\) IN wards) Tj T* (     pct <- occ/beds*100 ; ratio <- occ/staff) Tj T* (     IF pct > 90 OR ratio > 4 OR vents_free = 0 THEN flag ward) Tj T* (  SORT patients BY severity descending) Tj T* (  FOR each patient) Tj T* (     FOR each ward) Tj T* (        IF free bed AND \(not needs_vent OR vents_free > 0\) THEN assign ; BREAK) Tj T* (     IF not assigned THEN PRINT "waiting") Tj T* (END) Tj T* ET
Q
