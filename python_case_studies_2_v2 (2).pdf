BT 1 0 0 1 4 359.5 Tm 10.5 TL /F5 8 Tf 0 0 0 rg (# Case Study 47: Sports Tournament Ranking System) Tj T* (teams = ["Lions", "Tigers", "Eagles", "Sharks"]) Tj T* (matches = [) Tj T* (    \("Lions", 2, "Tigers", 1\), \("Eagles", 0, "Sharks", 0\),) Tj T* (    \("Lions", 1, "Eagles", 1\), \("Tigers", 3, "Sharks", 1\),) Tj T* (    \("Lions", 0, "Sharks", 2\), \("Tigers", 2, "Eagles", 2\),) Tj T* (]) Tj T* (table = []          # [name, P, W, D, L, GF, GA, Pts]) Tj T* (for t in teams:) Tj T* (    table.append\([t, 0, 0, 0, 0, 0, 0, 0]\)) Tj T* (for a, ga, b, gb in matches:) Tj T* (    ra = table[teams.index\(a\)]) Tj T* (    rb = table[teams.index\(b\)]) Tj T* (    ra[1] += 1; rb[1] += 1) Tj T* (    ra[5] += ga; ra[6] += gb) Tj T* (    rb[5] += gb; rb[6] += ga) Tj T* (    if ga ) Tj (>) Tj ( gb:) Tj T* (        ra[2] += 1; rb[4] += 1; ra[7] += 3) Tj T* (    elif ga ) Tj (<) Tj ( gb:) Tj T* (        rb[2] += 1; ra[4] += 1; rb[7] += 3) Tj T* (    else:) Tj T* (        ra[3] += 1; rb[3] += 1; ra[7] += 1; rb[7] += 1) Tj T* (n = len\(table\)) Tj T* (for i in range\(n\):) Tj T* (    for j in range\(n - 1 - i\):) Tj T* (        x, y = table[j], table[j + 1]) Tj T* (        kx = \(x[7], x[5] - x[6], x[5]\)) Tj T* (        ky = \(y[7], y[5] - y[6], y[5]\)) Tj T* (        if kx ) Tj (<) Tj ( ky or \(kx == ky and x[0] ) Tj (>) Tj ( y[0]\):) Tj T* (            table[j], table[j + 1] = y, x) Tj T* (print\(f"{'Rank':) Tj (<) Tj (5}{'Team':) Tj (<) Tj (8}{'P':) Tj (>) Tj (3}{'W':) Tj (>) Tj (3}{'D':) Tj (>) Tj (3}{'L':) Tj (>) Tj (3}{'GF':) Tj (>) Tj (4}{'GA':) Tj (>) Tj (4}{'GD':) Tj (>) Tj (4}{'Pts':) Tj (>) Tj (5}"\)) Tj T* (rank = 1) Tj T* (for name, p, w, d, l, gf, ga, pts in table:) Tj T* (    print\(f"{rank:) Tj (<) Tj (5}{name:) Tj (<) Tj (8}{p:) Tj (>) Tj (3}{w:) Tj (>) Tj (3}{d:) Tj (>) Tj (3}{l:) Tj (>) Tj (3}{gf:) Tj (>) Tj (4}{ga:) Tj (>) Tj (4}{gf-ga:) Tj (>) Tj (4}{pts:) Tj (>) Tj (5}"\)) Tj T* (    rank += 1) Tj T* ET
Q
Q
