BT 1 0 0 1 4 422.5 Tm 10.5 TL /F5 8 Tf 0 0 0 rg (# Case Study 99: Integrated E-Commerce Order Processing and Reconciliation) Tj T* (catalog = [) Tj T* (    ["P01", "Headphones", 1500, 20],) Tj T* (    ["P02", "Keyboard", 800, 15],) Tj T* (    ["P03", "Mouse", 400, 30],) Tj T* (    ["P04", "Monitor", 9000, 5],) Tj T* (]) Tj T* (codes = [p[0] for p in catalog]) Tj T* (orders = [\("O1", "P01", 4\), \("O2", "P03", 6\), \("O3", "P04", 6\),) Tj T* (          \("O4", "P02", 2\), \("O5", "P04", 1\), \("O6", "P05", 1\)]) Tj T* (returns = [\("O2", "P03", 1, 360.0\)]           # order, code, qty, unit price paid) Tj T* (physical = [16, 13, 24, 4]) Tj T* (revenue = 0) Tj T* (print\("ORDER LOG"\)) Tj T* (for oid, code, qty in orders:) Tj T* (    if code not in codes:) Tj T* (        print\(f"  {oid}: REJECTED - unknown product {code}"\)) Tj T* (        continue) Tj T* (    p = catalog[codes.index\(code\)]) Tj T* (    if qty ) Tj (>) Tj ( p[3]:) Tj T* (        print\(f"  {oid}: REJECTED - only {p[3]} {p[1]} in stock"\)) Tj T* (        continue) Tj T* (    value = qty * p[2]) Tj T* (    rate = 0.10 if value ) Tj (>) Tj (= 5000 else \(0.05 if qty ) Tj (>) Tj (= 5 else 0\)) Tj T* (    net = value - value * rate) Tj T* (    p[3] -= qty) Tj T* (    revenue += net) Tj T* (    print\(f"  {oid}: {qty} x {p[1]:) Tj (<) Tj (10} value={value:) Tj (>) Tj (6} disc={int\(rate*100\)}% net={net:) Tj (>) Tj (8.1f}"\)) Tj T* (print\("RETURNS"\)) Tj T* (for oid, code, qty, paid in returns:) Tj T* (    p = catalog[codes.index\(code\)]) Tj T* (    p[3] += qty) Tj T* (    revenue -= qty * paid) Tj T* (    print\(f"  {oid}: {qty} x {p[1]} returned, refund {qty*paid:.1f}"\)) Tj T* (print\(f"\\nNet revenue: Rs {revenue:.1f}\\n"\)) Tj T* (print\(f"{'Code':) Tj (<) Tj (5}{'Product':) Tj (<) Tj (11}{'System':) Tj (>) Tj (7}{'Physical':) Tj (>) Tj (9}  Status"\)) Tj T* (for i in range\(len\(catalog\)\):) Tj T* (    code, name, price, st = catalog[i]) Tj T* (    diff = physical[i] - st) Tj T* (    status = "OK" if diff == 0 else f"Mismatch \({diff:+d}\)") Tj T* (    print\(f"{code:) Tj (<) Tj (5}{name:) Tj (<) Tj (11}{st:) Tj (>) Tj (7}{physical[i]:) Tj (>) Tj (9}  {status}"\)) Tj T* ET
Q
