BT 1 0 0 1 4 296.5 Tm 10.5 TL /F5 8 Tf 0 0 0 rg (# Case Study 65: Campus Resource Allocation Under Constraints) Tj T* (resources = ["Projector", "Laptop", "Chair", "Mic"]) Tj T* (stock = [5, 20, 300, 6]) Tj T* (activities = [) Tj T* (    ["Tech Fest", 2, 3, 12, 150, 3],) Tj T* (    ["Convocation", 1, 2, 2, 250, 4],) Tj T* (    ["Workshop", 3, 2, 15, 60, 1],) Tj T* (    ["Cultural Night", 2, 1, 0, 100, 3],) Tj T* (]) Tj T* (n = len\(activities\)) Tj T* (for i in range\(n\):) Tj T* (    for j in range\(n - 1 - i\):) Tj T* (        if activities[j][1] ) Tj (>) Tj ( activities[j + 1][1]:) Tj T* (            activities[j], activities[j + 1] = activities[j + 1], activities[j]) Tj T* (print\("Available:", list\(zip\(resources, stock\)\)\)) Tj T* (for act in activities:) Tj T* (    name, pr = act[0], act[1]) Tj T* (    need = act[2:]) Tj T* (    given, short = [], []) Tj T* (    for r in range\(len\(resources\)\):) Tj T* (        g = need[r] if need[r] ) Tj (<) Tj (= stock[r] else stock[r]) Tj T* (        stock[r] -= g) Tj T* (        given.append\(g\)) Tj T* (        short.append\(need[r] - g\)) Tj T* (    status = "Fully met" if sum\(short\) == 0 else "Shortage") Tj T* (    print\(f"\\n[{pr}] {name}: {status}"\)) Tj T* (    print\("   Allocated:", given\)) Tj T* (    print\("   Shortage :", short\)) Tj T* (print\("\\nRemaining stock:", list\(zip\(resources, stock\)\)\)) Tj T* ET
Q
Q
q
