BT 1 0 0 1 4 97 Tm /F5 8 Tf 10.5 TL (BEGIN) Tj T* (  SORT activities BY priority ascending) Tj T* (  FOR each activity) Tj T* (     FOR each resource r) Tj T* (        give <- MIN\(need[r], stock[r]\)) Tj T* (        stock[r] <- stock[r] - give) Tj T* (        short[r] <- need[r] - give) Tj T* (     PRINT activity, give list, short list) Tj T* (  PRINT remaining stock) Tj T* (END) Tj T* ET
