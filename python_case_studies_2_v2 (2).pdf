BT 1 0 0 1 4 307 Tm 10.5 TL /F5 8 Tf 0 0 0 rg (# Case Study 55: Tuple-Based Transaction Audit) Tj T* (txns = \() Tj T* (    \("T001", "A1", 5000, "CR"\), \("T002", "A1", 2000, "DR"\),) Tj T* (    \("T003", "A2", -300, "DR"\), \("T002", "A2", 1500, "CR"\),) Tj T* (    \("T004", "A1", 1000, "DR"\), \("T005", "A1", 800, "DR"\),) Tj T* (    \("T006", "A3", 75000, "DR"\), \("T007", "A2", 400, "XX"\),) Tj T* (\)) Tj T* (seen, accounts, streak = [], [], []) Tj T* (dup = inv = sus = 0) Tj T* (print\(f"{'TxnID':) Tj (<) Tj (6}{'Acc':) Tj (<) Tj (4}{'Amount':) Tj (>) Tj (8} {'Type':) Tj (<) Tj (5}Issues"\)) Tj T* (for tid, acc, amt, typ in txns:) Tj T* (    issues = []) Tj T* (    if tid in seen:) Tj T* (        issues.append\("Duplicate ID"\); dup += 1) Tj T* (    else:) Tj T* (        seen.append\(tid\)) Tj T* (    if amt ) Tj (<) Tj (= 0:) Tj T* (        issues.append\("Invalid amount"\); inv += 1) Tj T* (    if typ not in \("CR", "DR"\):) Tj T* (        issues.append\("Invalid type"\); inv += 1) Tj T* (    if acc not in accounts:) Tj T* (        accounts.append\(acc\); streak.append\(0\)) Tj T* (    k = accounts.index\(acc\)) Tj T* (    streak[k] = streak[k] + 1 if typ == "DR" else 0) Tj T* (    if streak[k] ) Tj (>) Tj (= 3:) Tj T* (        issues.append\("3+ consecutive debits"\); sus += 1) Tj T* (    if typ == "DR" and amt ) Tj (>) Tj ( 50000:) Tj T* (        issues.append\("Large withdrawal"\); sus += 1) Tj T* (    print\(f"{tid:) Tj (<) Tj (6}{acc:) Tj (<) Tj (4}{amt:) Tj (>) Tj (8} {typ:) Tj (<) Tj (5}{', '.join\(issues\) if issues else 'OK'}"\)) Tj T* (print\(f"\\nSummary: {len\(txns\)} transactions | duplicates={dup} invalid={inv} suspicious={sus}"\)) Tj T* ET
Q
Q
