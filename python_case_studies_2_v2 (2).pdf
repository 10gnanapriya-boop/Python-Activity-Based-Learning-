BT 1 0 0 1 4 97 Tm /F5 8 Tf 10.5 TL (BEGIN) Tj T* (  FOR each \(oid, code, qty\) IN orders) Tj T* (     IF qty > stock[code] THEN reject) Tj T* (     ELSE value <- qty*price ; apply discount rule) Tj T* (          stock[code] -= qty ; revenue += net) Tj T* (  FOR each \(code, qty\) IN returns) Tj T* (     stock[code] += qty ; revenue -= qty*unit_paid) Tj T* (  FOR each product: IF stock <> physical THEN discrepancy) Tj T* (  PRINT revenue and inventory table) Tj T* (END) Tj T* ET
Q
