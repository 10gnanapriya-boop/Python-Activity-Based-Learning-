BT 1 0 0 1 4 328 Tm 10.5 TL /F5 8 Tf 0 0 0 rg (# Case Study 82: Multi-Criteria Internship Candidate Ranking) Tj T* (candidates = [) Tj T* (    \("Anu", 8.5, 78, 80, 88, 0\), \("Bala", 9.1, 70, 75, 92, 0\),) Tj T* (    \("Charan", 6.8, 90, 85, 95, 0\), \("Divya", 8.0, 85, 70, 80, 0\),) Tj T* (    \("Esha", 8.5, 78, 80, 70, 0\), \("Farhan", 7.6, 88, 77, 85, 1\),) Tj T* (    \("Gita", 8.2, 85, 72, 90, 0\),) Tj T* (]) Tj T* (eligible, rejected = [], []) Tj T* (for name, cgpa, test, intv, att, back in candidates:) Tj T* (    reasons = []) Tj T* (    if cgpa ) Tj (<) Tj ( 7: reasons.append\("CGPA) Tj (<) Tj (7"\)) Tj T* (    if att ) Tj (<) Tj ( 75: reasons.append\("Attendance) Tj (<) Tj (75"\)) Tj T* (    if back ) Tj (>) Tj ( 0: reasons.append\("Backlogs"\)) Tj T* (    if reasons:) Tj T* (        rejected.append\(\(name, ", ".join\(reasons\)\)\)) Tj T* (    else:) Tj T* (        score = round\(0.4 * cgpa * 10 + 0.35 * test + 0.25 * intv, 2\)) Tj T* (        eligible.append\(\(score, test, cgpa, name\)\)) Tj T* (n = len\(eligible\)) Tj T* (for i in range\(n\):) Tj T* (    for j in range\(n - 1 - i\):) Tj T* (        a, b = eligible[j], eligible[j + 1]) Tj T* (        if a[:3] ) Tj (<) Tj ( b[:3] or \(a[:3] == b[:3] and a[3] ) Tj (>) Tj ( b[3]\):) Tj T* (            eligible[j], eligible[j + 1] = b, a) Tj T* (print\(f"{'Rank':) Tj (<) Tj (5}{'Name':) Tj (<) Tj (8}{'Score':) Tj (>) Tj (7}{'Test':) Tj (>) Tj (6}{'CGPA':) Tj (>) Tj (6}  Status"\)) Tj T* (for r in range\(n\):) Tj T* (    score, test, cgpa, name = eligible[r]) Tj T* (    status = "SELECTED" if r ) Tj (<) Tj ( 3 else "Waitlist") Tj T* (    print\(f"{r+1:) Tj (<) Tj (5}{name:) Tj (<) Tj (8}{score:) Tj (>) Tj (7.2f}{test:) Tj (>) Tj (6}{cgpa:) Tj (>) Tj (6}  {status}"\)) Tj T* (print\("\\nNot eligible:"\)) Tj T* (for name, why in rejected:) Tj T* (    print\(f"  {name:) Tj (<) Tj (8} {why}"\)) Tj T* ET
