BT 1 0 0 1 4 359.5 Tm 10.5 TL /F5 8 Tf 0 0 0 rg (# Case Study 36: Repeated Word and Phrase Detection) Tj T* (text = \("Python is easy. Python is powerful, and learning Python is fun! ") Tj T* (        "Practice makes Python easy and practice makes perfect."\)) Tj T* (clean = text.lower\(\)) Tj T* (for ch in ".,!?;:":) Tj T* (    clean = clean.replace\(ch, " "\)) Tj T* (words = clean.split\(\)) Tj T* (uniq, counts, positions = [], [], []) Tj T* (for i in range\(len\(words\)\):) Tj T* (    w = words[i]) Tj T* (    if w in uniq:) Tj T* (        k = uniq.index\(w\)) Tj T* (        counts[k] += 1) Tj T* (        positions[k].append\(i + 1\)) Tj T* (    else:) Tj T* (        uniq.append\(w\)) Tj T* (        counts.append\(1\)) Tj T* (        positions.append\([i + 1]\)) Tj T* (print\("Total words:", len\(words\), "| Unique words:", len\(uniq\)\)) Tj T* (print\("Repeated words:"\)) Tj T* (for k in range\(len\(uniq\)\):) Tj T* (    if counts[k] ) Tj (>) Tj ( 1:) Tj T* (        print\(f"  {uniq[k]:) Tj (<) Tj (10} count={counts[k]}  positions={positions[k]}"\)) Tj T* (phrases, pcount = [], []) Tj T* (for i in range\(len\(words\) - 1\):) Tj T* (    p = words[i] + " " + words[i + 1]) Tj T* (    if p in phrases:) Tj T* (        pcount[phrases.index\(p\)] += 1) Tj T* (    else:) Tj T* (        phrases.append\(p\)) Tj T* (        pcount.append\(1\)) Tj T* (print\("Repeated phrases:"\)) Tj T* (for k in range\(len\(phrases\)\):) Tj T* (    if pcount[k] ) Tj (>) Tj ( 1:) Tj T* (        print\(f"  '{phrases[k]}' x{pcount[k]}"\)) Tj T* ET
Q
Q
q
