%PreformattedPara
0 0 0 rg
BT 1 0 0 1 4 97 Tm /F5 8 Tf 10.5 TL (BEGIN) Tj T* (  seen <- [] ; accounts <- [] ; streak <- []) Tj T* (  FOR each \(tid, acc, amt, typ\) IN txns) Tj T* (     IF tid IN seen THEN flag "Duplicate" ELSE seen.append\(tid\)) Tj T* (     IF amt <= 0 THEN flag "Invalid amount") Tj T* (     IF typ NOT IN \("CR","DR"\) THEN flag "Invalid type") Tj T* (     IF typ = "DR" THEN streak[acc] += 1 ELSE streak[acc] <- 0) Tj T* (     IF streak[acc] >= 3 OR \(typ="DR" AND amt > 50000\) THEN flag "Suspicious") Tj T* (  PRINT report) Tj T* (END) Tj T* ET
Q
